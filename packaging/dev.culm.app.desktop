[Desktop Entry]
Type=Application
Name=Culm
GenericName=Addon manager
Comment=Addon manager for World of Warcraft: Forever
# Replace with the absolute path of your build, e.g. /home/you/Projects/culm/target/release/culm
Exec=/path/to/culm/target/release/culm
# Copy packaging/culm.svg to ~/.local/share/icons/hicolor/scalable/apps/culm.svg
Icon=culm
Terminal=false
Categories=Game;Utility;
StartupWMClass=dev.culm.app
